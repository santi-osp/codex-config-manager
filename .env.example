# ==============================================================================
# CodexConfigManager - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for custom local overrides (never commit .env)
# All settings below have sensible automatic defaults for standard Windows installations.

# Port for the local management HTTP bridge (default: 20129)
PORT=20129

# OmniRoute Gateway address (default: http://127.0.0.1:20128)
OMNIROUTE_URL=http://127.0.0.1:20128

# Optional: OmniRoute API key override (if not reading from local storage.sqlite)
# OMNIROUTE_API_KEY=sk-placeholder-omniroute-key-here

# Optional: Custom path overrides (defaults to %USERPROFILE%\.codex and %APPDATA%\omniroute)
# CODEX_CONFIG_PATH=C:\Users\Username\.codex\config.toml
# CODEX_STATE_DB_PATH=C:\Users\Username\.codex\state_5.sqlite
# OMNIROUTE_DB_PATH=C:\Users\Username\AppData\Roaming\omniroute\storage.sqlite

# Run in offline simulation / demo mode with fictional accounts (default: false)
DEMO_MODE=false
