# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly ensure Windows scripts use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.vbs text eol=crlf

# Source and documentation use LF
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.svg text eol=lf

# Binary files
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
