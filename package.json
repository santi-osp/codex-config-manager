{
  "name": "codex-config-manager",
  "version": "2.1.1",
  "description": "Retro-pixel desktop control plane and telemetry monitor for OpenAI Codex and OmniRoute on Windows",
  "type": "module",
  "main": "src/server/config-manager-server.mjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/santi-osp/codex-config-manager.git"
  },
  "homepage": "https://github.com/santi-osp/codex-config-manager#readme",
  "bugs": {
    "url": "https://github.com/santi-osp/codex-config-manager/issues"
  },
  "scripts": {
    "start": "node src/server/config-manager-server.mjs",
    "demo": "node -e \"process.env.DEMO_MODE='true'; import('./src/server/config-manager-server.mjs');\"",
    "test": "node scripts/run-all-tests.mjs",
    "test:unit": "node tests/toml-engine.test.mjs",
    "test:security": "node tests/security.test.mjs",
    "test:disk": "node tests/e2e-disk-persistence.test.mjs",
    "test:e2e": "node tests/e2e.test.mjs",
    "docs:screenshots": "node tests/e2e.test.mjs --screenshots"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "codex",
    "windows",
    "omniroute",
    "nodejs",
    "local-dashboard",
    "configuration-manager",
    "vanilla-javascript",
    "toml",
    "reasoning-effort"
  ],
  "author": "santi-osp",
  "license": "MIT",
  "dependencies": {
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
